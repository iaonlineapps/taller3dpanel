# Copia este archivo a .env y ajústalo (install.sh lo hace por ti la primera vez).

# Carpeta donde se guardan TODOS los datos (la base de datos taller3d.db con piezas, fotos,
# ventas, clientes y ajustes). En una Raspberry Pi conviene un disco externo, no la tarjeta SD.
# Ejemplo: DATA_DIR=/mnt/disco/taller3d-panel
DATA_DIR=./data

# Puerto en el que se abre la web (http://IP-DE-TU-PI:8095)
PORT=8095

# Zona horaria (lista: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=Europe/Madrid

# UID/GID del usuario dueño de los archivos (mira el tuyo con: id -u ; id -g)
PUID=1000
PGID=1000

# Opcional: crea este administrador al arrancar si no existe.
# Si lo dejas vacío, la primera vez que abras la web te pedirá crear el administrador.
# Usa una contraseña larga y no subas nunca el archivo .env a GitHub.
ADMIN_USER=
ADMIN_PASSWORD=

# 1 = cualquiera puede pedir cuenta (el admin la activa); 0 = solo el admin crea cuentas
ALLOW_REGISTER=1

# 1 = pedir email al crear cuentas (recomendado si la usan varias personas); 0 = solo usuario y contraseña
REQUIRE_EMAIL=1

# 1 = la web está detrás de un proxy (Nginx Proxy Manager, Pangolin, Cloudflare Tunnel...)
TRUST_PROXY=0
